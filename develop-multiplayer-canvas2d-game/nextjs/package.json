{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static:netlify": "node scripts/build-static-netlify.mjs",
    "start": "next start",
    "server:start": "tsx server/index.ts",
    "build:cpp": "cd server-cpp && g++ -std=c++20 -O2 main.cpp -I../uWebSockets/src -I../uWebSockets/uSockets/src ../uWebSockets/uSockets/*.o -lz -lssl -lcrypto -o petalia-server",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.1",
    "typescript": "5.9.3"
  }
}
